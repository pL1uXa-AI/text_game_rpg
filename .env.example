# ═══════════════════════════════════════════════
# Text Game RPG — конфигурация
# ═══════════════════════════════════════════════

# ── Основная модель: провайдер (llamacpp | ollama | openai_compat) ──
MAIN_PROVIDER=openai_compat
# Переопределение для ollama/openai_compat:
MAIN_BASE_URL=https://routerai.ru/api/v1
MAIN_API_KEY=
MAIN_MODEL=upstage/solar-pro4

# ── Облачный эмбеддинг (RouterAI, OpenAI-совместимый API) ──
EMBEDDING_PROVIDER=routerai
EMBEDDING_BASE_URL=https://routerai.ru/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096

# ── Ранжирование (провайдер routerai | openai_compat | none) ──
RERANK_PROVIDER=routerai
RERANK_BASE_URL=https://routerai.ru/api/v1
RERANK_API_KEY=
RERANK_MODEL=voyageai/rerank-2.5
RERANK_ENABLED=true
RERANK_TOP_N=20
RERANK_THRESHOLD=0.2

# ── Гибрид ──
HYBRID_WEIGHT_BM25=0.4
COSINE_THRESHOLD=0.35

# ── Локальная ChromaDB (СВОЙ экземпляр игры, порт 8001) ──
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=text_game_memory

# ── llama.cpp сервер (уже запущен) ──
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# LLAMA_MODEL=

# ── API игры ──
GAME_HOST=127.0.0.1
GAME_PORT=8002
DB_PATH=data/game.db

# ── Параметры генерации по умолчанию ──
DEFAULT_TEMP=0.8
DEFAULT_TOP_P=0.95
MAX_TOKENS=2000
# Размер контекста мира по умолчанию (токены; память = контекст − оверхед − ответ).
# Стандарт 32k (32768) — под облачные модели с большим контекстом (RouterAI и др.).
# Для локальной llama.cpp (n_ctx 8192) уменьшай per-world в настройках мира.
CONTEXT_TOKENS=32768

# ── Память ──
RECENT_TOKEN_BUDGET=2600
SUMMARY_TOKEN_BUDGET=700
# Сколько RAG-фактов памяти вспоминать (база при контексте 32k). При большем окне мира
# (128k/256k) это число растёт пропорционально вплоть до RAG_MEMORY_MAX — окно памяти
# реально используется, а не упирается в фиксированные 4 факта.
RAG_MEMORY_K=4
RAG_MEMORY_MAX=24
RAG_CANDIDATES=20
# Лор мира («библия»): бюджет токенов и число RAG-чанков в промпт (база при 32k,
# растёт до потолков при большом контексте).
LORE_TOKEN_BUDGET=900
LORE_TOKEN_BUDGET_MAX=4500
LORE_RAG_K=3
LORE_RAG_K_MAX=12

# ── Динамические события мира (фоновая генерация) ──
# Срабатывают ТОЛЬКО по ходам игрока (таймер по реальному времени убран — пока игрок
# offline, мир не «живёт» сам).
DYNAMIC_EVENTS_ENABLED=true
# Шанс события растёт каждый ход: p = (ходов с прошлого события) / EVENT_EVERY_TURNS, но
# никогда не гарантирован (потолок 0.5) — события случаются «по случаю», а не по расписанию
EVENT_EVERY_TURNS=10

# Глобальный выключатель фоновых задач памяти: RAG-индексация обменов/сводок/карточек,
# карточки сущностей (LLM-архивариус). Выкл = быстрее/дешевле (напр. на медленном/облачном
# тарифе), но память деградирует (никаких сводок/карточек/индексации). Динамические события
# и судья логики управляются своими флагами (DYNAMIC_EVENTS_ENABLED / LOGIC_JUDGE_ENABLED).
BACKGROUND_TASKS_ENABLED=true

# ── Действия игрока ──
# Максимальная длина действия (символов): защита от многотысячного ввода,
# который ломает токен-бюджет контекста (640 ≈ 200 токенов при len/3.2)
MAX_ACTION_CHARS=640

# ── Судья логики (фоновая проверка противоречий) ──
# После каждого хода асинхронный LLM-проход сверяет ответ рассказчика с критичными фактами
# мира (живые NPC, флаги, состояние). Ошибку НЕ переписывает, а оформляет системным
# сообщением-«искажением реальности» (сюжетный поворот) — см. Аудит логики.txt, Стратегия Б.
# Работает в фоне и НЕ замедляет ответ игроку. Per-world выключается в настройках мира.
LOGIC_JUDGE_ENABLED=true
# Проверять не чаще чем раз в N ходов игрока (экономия токенов; 1 = каждый ход)
LOGIC_JUDGE_INTERVAL=3

# ── Авто-тик эффектов (яд/кровотечение/регенерация) ──
# Включён по умолчанию: статус-эффекты тикают (урон/лечение ×стаки, turns−1) в начале
# хода. Уровень и профессии код НЕ решает (только директивами рассказчика), но тик
# эффектов — это «физический движок». Если хочешь, чтобы мастер сам вёл урон/лечение
# директивами player.hp/effect_apply — поставь false (эффекты перестанут тикать сами).
TICK_EFFECTS_ENABLED=true

# Потребности/рассудок (сессия 32): голод/жажда/усталость и рассудок/стресс/мораль
# тикают сами в начале каждого хода (убыль/рост по decay). Движок предупреждает при
# критическом уровне, НО последствия (эффекты/штрафы/сюжет) ведёт рассказчик директивами.
TICK_NEEDS_ENABLED=true

# ── Озвучка рассказчика (TTS): piper | kokoro | edge | none ──
# piper — локальный (sherpa-onnx, русские голоса ru_RU-*, скачиваются кнопкой в настройках, качество среднее)
# edge — ⭐ рекомендован: облачный Microsoft Edge TTS (лучшие русские голоса, бесплатно, нужен интернет)
# kokoro — локальный Kokoro-82M (без русского, для англ. миров)
TTS_ENABLED=true
TTS_PROVIDER=edge
# Голос по умолчанию (пусто = голос по умолчанию для провайдера):
# edge: ru-RU-DmitryNeural (муж.) — стандарт | ru-RU-SvetlanaNeural (жен.)
# piper: ru_RU-ruslan-medium | ru_RU-irina-medium | ru_RU-dmitri-medium | ru_RU-denis-medium
# kokoro: af_heart | af_bella | am_michael | am_fenrir
TTS_VOICE=ru-RU-DmitryNeural
# Скорость речи: от -50% до +50% (например +0%, +20%, -10%)
TTS_RATE=+0%
TTS_AUTO_PLAY=false
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_DAYS=60
TTS_MAX_CHARS=2400

# ── Переносимость и наблюдаемость (сессия 33) ──
# Авто-детект реального размера контекста модели (llama.cpp /props, Ollama /api/show,
# OpenAI-совместимые /models). Не даёт миру заявить окно больше, чем тянет модель, —
# иначе ответы молча обрезаются (правило 4: локальная llama.cpp = 8192 при стандарте 32k).
DETECT_MODEL_CONTEXT=true
# Снимок data/game.db при каждом запуске сервера в data/backups/ (SQLite Backup API —
# согласованный, даже если идут ходы). game.db в git не лежит: это страховка от потери
# долгого прохождения. keep — сколько последних снимков держать.
BACKUP_DB_ON_START=true
BACKUP_KEEP=10
# Метрики ходов (время LLM, токены, размер памяти, повторы) переживают перезапуск:
# каждый ход дописывается строкой в data/metrics.jsonl; /api/metrics читает хвост,
# когда собственный in-memory буфер пуст (свежий старт).
METRICS_PERSIST=true
METRICS_FILE=data/metrics.jsonl
METRICS_TAIL=500
