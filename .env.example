# ═══════════════════════════════════════════════
# Text Game RPG — конфигурация
# ═══════════════════════════════════════════════

# ── Основная модель: провайдер (llamacpp | ollama | openai_compat) ──
MAIN_PROVIDER=openai_compat
# Переопределение для ollama/openai_compat:
MAIN_BASE_URL=https://routerai.ru/api/v1
MAIN_API_KEY=
MAIN_MODEL=upstage/solar-pro4

# ── Облачный эмбеддинг (RouterAI, OpenAI-совместимый API) ──
EMBEDDING_PROVIDER=routerai
EMBEDDING_BASE_URL=https://routerai.ru/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096
# Префиксы для облачных эмбеддеров qwen3 (документ/запрос) — без них поиск хуже.
PREFIX_DOC=Passage: 
PREFIX_QUERY=Query: 

# ── Локальный оффлайн-эмбеддинг (EMBEDDING_PROVIDER=local) ──
# Полный оффлайн без ключей/интернета. Chroma держит одну размерность на коллекцию,
# поэтому для local — своя коллекция (384-dim), см. AGENT.md «Память, слой 3».
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DIM=384
LOCAL_EMBEDDING_CACHE=data/fastembed

# ── Ранжирование (провайдер routerai | openai_compat | none) ──
RERANK_PROVIDER=routerai
RERANK_BASE_URL=https://routerai.ru/api/v1
RERANK_API_KEY=
RERANK_MODEL=voyageai/rerank-2.5
RERANK_ENABLED=true
# Порог релевантности (0 = фильтр выключен). Аудит 38 (A17): настройка НАЧАЛА работать —
# embeddings.rerank_results отбрасывает кандидатов с relevance_score ниже порога.
# Отдельной ручки «сколько вернуть» больше нет: размер выдачи = RAG_MEMORY_K / LORE_RAG_K.
# Если в твоём .env остался RERANK_TOP_N — он мёртвый (A17), смело удаляй строку: конфиг
# теперь сам пишет в журнал про каждый ключ, которого он не читает (B5, аудит 41).
RERANK_THRESHOLD=0.2

# ── Гибрид ──
HYBRID_WEIGHT_BM25=0.4
COSINE_THRESHOLD=0.35
# Порог для локального эмбеддера (fastembed даёт разрежённые близости) — ниже
COSINE_THRESHOLD_LOCAL=0.20

# ── Локальная ChromaDB (СВОЙ экземпляр игры, порт 8001) ──
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=text_game_memory

# ── llama.cpp сервер (уже запущен) ──
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# Модель для явной отправки в запрос (пусто — сервер сам выбирает загруженную)
LLAMA_MODEL=

# ── API игры ──
# B5 (аудит 41): ключей GAME_HOST/GAME_PORT здесь больше нет — их читал только config.py, а
# реальность была другой: адрес слушания задаёт `GAME_BIND` окружения процесса (по умолчанию
# 127.0.0.1, чужой адрес требует GAME_BIND_CONFIRM=1 — правило 5), а порт в start_game.bat
# жёсткий (8002, на него завязаны фронт и проверка scripts/check_start_bat.py). Приложение не
# выбирает порт — это делает раннер (uvicorn), так что «настройка» ничего бы не изменила.
# Сервер из коробки: http://127.0.0.1:8002 (играется) и /admin (админка).
DB_PATH=data/game.db
# B2 (аудит 41): у игры НЕТ авторизации, поэтому /api/admin/settings (правка провайдеров,
# MAIN_BASE_URL и API-ключей) отвечает только с localhost. Если админка реально нужна с
# другого устройства (телефон при GAME_BIND=0.0.0.0) — поставь true ОСОЗНАННО: это выдаёт
# запись ключей всей локальной сети. Через саму админку ключ не включается (hidden).
ADMIN_ALLOW_LAN=false
# Rate-limit «дорогих» эндпоинтов (LLM/облако/TTS/импорт) — реестр лимитов в
# backend/ratelimit.py::SCOPES; false отключает его целиком (нужно только для отладки
# и автотестов: тестовый клиент бьёт с одного адреса быстрее любого лимита).
RATE_LIMIT_ENABLED=true

# ── Параметры генерации по умолчанию ──
# A9 (аудит 41): у всех числовых настроек есть границы — `backend/config.py::NUM_RANGES`.
# Кривое значение (MAX_TOKENS=0, LLM_TIMEOUT=0.01, TURN_SNAPSHOT_KEEP=1, LOG_MAX_BYTES=1)
# раньше доходило до модели и ломало КАЖДЫЙ ход; теперь оно подрезается при чтении конфига,
# при сохранении админки и при чтении настроек мира — всегда с warning-ом в журнале.
# Те же границы действуют и в per-world настройках, и в .env, и в админке (одна точка истины).
DEFAULT_TEMP=0.8
DEFAULT_TOP_P=0.95
MAX_TOKENS=2000
# Размер контекста мира по умолчанию (токены; память = контекст − оверхед − ответ).
# Стандарт 32k (32768) — под облачные модели с большим контекстом (RouterAI и др.).
# Для локальной llama.cpp (n_ctx 8192) уменьшай per-world в настройках мира.
CONTEXT_TOKENS=32768

# ── Память ──
RECENT_TOKEN_BUDGET=2600
SUMMARY_TOKEN_BUDGET=700
# Сколько RAG-фактов памяти вспоминать (база при контексте 32k). При большем окне мира
# (128k/256k) это число растёт пропорционально вплоть до RAG_MEMORY_MAX — окно памяти
# реально используется, а не упирается в фиксированные 4 факта.
RAG_MEMORY_K=4
RAG_MEMORY_MAX=24
RAG_CANDIDATES=20
# Лор мира («библия»): бюджет токенов и число RAG-чанков в промпт (база при 32k,
# растёт до потолков при большом контексте).
LORE_TOKEN_BUDGET=900
LORE_TOKEN_BUDGET_MAX=4500
LORE_RAG_K=3
LORE_RAG_K_MAX=12

# ── Динамические события мира (фоновая генерация) ──
# Срабатывают ТОЛЬКО по ходам игрока (таймер по реальному времени убран — пока игрок
# offline, мир не «живёт» сам).
DYNAMIC_EVENTS_ENABLED=true
# Шанс события растёт каждый ход: p = (ходов с прошлого события) / EVENT_EVERY_TURNS, но
# никогда не гарантирован (потолок 0.5) — события случаются «по случаю», а не по расписанию
EVENT_EVERY_TURNS=10

# Глобальный выключатель фоновых задач памяти: RAG-индексация обменов/сводок/карточек,
# карточки сущностей (LLM-архивариус). Выкл = быстрее/дешевле (напр. на медленном/облачном
# тарифе), но память деградирует (никаких сводок/карточек/индексации). Динамические события
# и судья логики управляются своими флагами (DYNAMIC_EVENTS_ENABLED / LOGIC_JUDGE_ENABLED).
BACKGROUND_TASKS_ENABLED=true

# ── Действия игрока ──
# Максимальная длина действия (символов): защита от многотысячного ввода,
# который ломает токен-бюджет контекста (640 ≈ 200 токенов при len/3.2).
# B3 (аудит 41): остальные границы текстов (персона/сюжет/лор/зацеп/жалоба/карточки)
# настраиваемыми КЛЮЧАМИ НЕ ЗАВОДИЛИСЬ — они константами в backend/schemas.py
# (`PERSONA_MAX`, `PLOT_MAX`, `LORE_TEXT_MAX`, …) и тестом сверяются с `maxlength` фронта;
# искать здесь «LORE_MAX_CHARS» бесполезно. Персону, уже лежащую в базе, подрезает
# `narrator.PERSONA_TOKEN_BUDGET` при сборке промпта.
MAX_ACTION_CHARS=640

# ── Провидение (👁 воззвание игрока на ошибку рассказчика) ──
# Минимум ходов между воззваниями. По умолчанию 3 (сессия 36, п.2): с 0 игрок мог
# бесконечно просить у богов золото/предметы — ответы Провидения защитой не являются,
# их генерирует та же модель. 0 = вернуть прежнее неограниченное поведение.
DIVINE_COOLDOWN_TURNS=3

# ── Судья логики (фоновая проверка противоречий) ──
# После каждого хода асинхронный LLM-проход сверяет ответ рассказчика с критичными фактами
# мира (живые NPC, флаги, состояние). Ошибку НЕ переписывает, а оформляет системным
# сообщением-«искажением реальности» (сюжетный поворот) — см. Аудит логики.txt, Стратегия Б.
# Работает в фоне и НЕ замедляет ответ игроку. Per-world выключается в настройках мира.
LOGIC_JUDGE_ENABLED=true
# Проверять не чаще чем раз в N ходов игрока (экономия токенов; 1 = каждый ход)
LOGIC_JUDGE_INTERVAL=3

# ── Автономный «мастер» (сессия 25) ──
# Фоновый сюжетный агент: выводит из тупика (повтор действий / долго без квестов) —
# генерирует квест или сюжетный поворот («🤖 Мастер: …»). Не блокирует ответ, вмешивается редко.
AUTONOMOUS_MASTER_ENABLED=true
# Вмешиваться не чаще раза в N ходов игрока (экономия токенов)
AUTONOMOUS_MASTER_INTERVAL=6

# ── Боевой ИИ врагов (сессия 26) ──
# Пока в бою есть живые враги, фоново выбирает их тактический ход (преследование/охрана/
# отступление/переговоры/ловушка). Урон игроку НЕ наносит — это ход рассказчика.
ENEMY_AI_ENABLED=true
# Решать раз в N ходов игрока, пока живы враги (экономия токенов)
ENEMY_AI_INTERVAL=2

# ── Авто-тик эффектов (яд/кровотечение/регенерация) ──
# Включён по умолчанию: статус-эффекты тикают (урон/лечение ×стаки, turns−1) в начале
# хода. Уровень и профессии код НЕ решает (только директивами рассказчика), но тик
# эффектов — это «физический движок». Если хочешь, чтобы мастер сам вёл урон/лечение
# директивами player.hp/effect_apply — поставь false (эффекты перестанут тикать сами).
TICK_EFFECTS_ENABLED=true

# Потребности/рассудок (сессия 32): голод/жажда/усталость и рассудок/стресс/мораль
# тикают сами в начале каждого хода (убыль/рост по decay). Движок предупреждает при
# критическом уровне, НО последствия (эффекты/штрафы/сюжет) ведёт рассказчик директивами.
TICK_NEEDS_ENABLED=true

# Часы мира (сессия 40, п.14b): время суток само идёт по циклу утро → день → вечер → ночь
# каждые N ходов игрока, с системкой «🕐 Часы мира: вечер → ночь». Без этого время из
# сюжета («вечер») не меняется никогда, пока мастер сам не даст директиву time, и
# расписания NPC противоречат тексту. Движок ведёт только календарь: что значит ночь —
# на рассказчике (закон 3), и он может перевести стрелки директивой time. Погоду авто-
# часы НЕ трогают (это решение мастера). false — выключить авто-часы вовсе.
AUTO_TIME_ENABLED=true
# Ходов игрока на одну часть суток (4 ≈ сутки за 16 ходов; 0 = не двигать время)
AUTO_TIME_EVERY=4

# Сколько раз попросить модель дописать прозу, если она вернула только механику без
# текста (иначе вместо сцены игрок получил бы служебное «Механика применена.»).
MECH_NARRATE_RETRIES=2

# ── Озвучка рассказчика (TTS): piper | kokoro | edge | none ──
# piper — локальный (sherpa-onnx, русские голоса ru_RU-*, скачиваются кнопкой в настройках, качество среднее)
# edge — ⭐ рекомендован: облачный Microsoft Edge TTS (лучшие русские голоса, бесплатно, нужен интернет)
# kokoro — локальный Kokoro-82M (без русского, для англ. миров)
TTS_ENABLED=true
TTS_PROVIDER=edge
# Голос по умолчанию (пусто = голос по умолчанию для провайдера):
# edge: ru-RU-DmitryNeural (муж.) — стандарт | ru-RU-SvetlanaNeural (жен.)
# piper: ru_RU-ruslan-medium | ru_RU-irina-medium | ru_RU-dmitri-medium | ru_RU-denis-medium
# kokoro: af_heart | af_bella | am_michael | am_fenrir
TTS_VOICE=ru-RU-DmitryNeural
# Скорость речи: от -50% до +50% (например +0%, +20%, -10%)
TTS_RATE=+0%
TTS_AUTO_PLAY=false
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_DAYS=60
TTS_MAX_CHARS=2400

# ── Переносимость и наблюдаемость (сессия 33) ──
# Авто-детект реального размера контекста модели (llama.cpp /props, Ollama /api/show,
# OpenAI-совместимые /models). Не даёт миру заявить окно больше, чем тянет модель, —
# иначе ответы молча обрезаются (правило 4: локальная llama.cpp = 8192 при стандарте 32k).
DETECT_MODEL_CONTEXT=true
# Снимок data/game.db при каждом запуске сервера в data/backups/ (SQLite Backup API —
# согласованный, даже если идут ходы). game.db в git не лежит: это страховка от потери
# долгого прохождения. keep — сколько последних снимков держать.
BACKUP_DB_ON_START=true
BACKUP_KEEP=10
# Метрики ходов (время LLM, токены, размер памяти, повторы) переживают перезапуск:
# каждый ход дописывается строкой в data/metrics.jsonl; /api/metrics читает хвост,
# когда собственный in-memory буфер пуст (свежий старт).
METRICS_PERSIST=true
METRICS_FILE=data/metrics.jsonl
METRICS_TAIL=500
# Ротация журнала метрик (сессия 36, п.7): METRICS_TAIL ограничивает только ЧТЕНИЕ,
# а сам файл рос весь срок жизни игры. При переходе порога metrics.jsonl сдвигается в
# .1/.2/.3 (тот же подход, что у логов). 0 = ротация выключена.
METRICS_MAX_BYTES=4194304

# ── Сессия 34: наблюдаемость, устойчивость и ярусы промпта ──
# Структурированный JSON-лог в data/logs/game.log (контекст хода: world_id/turn_seq/agent).
# LOG_FILE=off — только консоль. Уровень: DEBUG видит легальные фолбэки и повторы.
LOG_LEVEL=INFO
LOG_FILE=data/logs/game.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
# Дамп собранного промпта хода в лог (DEBUG) — видно, что реально ушло в модель.
LOG_PROMPT_DUMP=false

# Ретраи временных сбоев LLM/Chroma/облака (429/5xx/таймаут). 0 — выключить.
LLM_RETRIES=2
LLM_RETRY_BACKOFF=0.8
LLM_TIMEOUT=300
CHROMA_RETRIES=1
EMBEDDING_RETRIES=1

# Очередь фоновых LLM-агентов (карточки/судья/мастер/боевой ИИ/события/видения):
# параллельность, потолок очереди, пауза на время хода игрока.
LLM_BG_CONCURRENCY=2
LLM_BG_MAX_QUEUE=32
LLM_BG_YIELD_TURN=true

# Ярусы системного промпта: убирать правила о подсистемах, которых в мире нет
# (крафт/фракции/таймеры/зоны и т.п.). Экономит токены (замер: 5550 → 3873).
PROMPT_TIERS_ENABLED=true
# Сколько точек перемотки (состояний перед ходом) хранить на мир для «⏪ назад к ходу N».
# TURN_SNAPSHOT_KEEP=0 — хранить все; иначе не меньше 10 (1–9 = перемотка «умирает» через
# несколько ходов, поэтому сервер подрезает такое значение до 10; потолок 100000).
TURN_SNAPSHOT_KEEP=120
